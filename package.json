{
  "name": "dsh-workbench-home",
  "version": "0.2.0",
  "description": "个人 DeepSeek Harness 工作台的「工作台首页 + 试作页」独立包：左侧「工作台」入口（技能卡片墙 + 能力盘点 + 下一阶段）与「试作」入口（一页纸的审美样本）。只注册自己那两页的插槽，可与其它三个单页包同时装。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "tools/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "workbench",
    "dsh-workbench-home"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
